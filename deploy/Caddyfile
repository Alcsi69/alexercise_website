# Alexercise website: add this block to /etc/caddy/Caddyfile on the VPS,
# next to the existing alexercise.app / api.alexercise.app blocks, then:
#   sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy
#
# Replace SITE_DOMAIN with the website's domain (and its www variant if you use one).
# Caddy gets the HTTPS certificate automatically once DNS points at the VPS.

SITE_DOMAIN, www.SITE_DOMAIN {
	# Canonical address without www.
	@www host www.SITE_DOMAIN
	redir @www https://SITE_DOMAIN{uri} permanent

	encode zstd gzip

	root * /var/www/alexercise-website
	file_server

	# Astro's own 404 page.
	handle_errors {
		@notfound expression {err.status_code} == 404
		root * /var/www/alexercise-website
		rewrite @notfound /404.html
		file_server
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# Hashed CSS/JS never change; pages must always revalidate so new posts show up.
	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@pages not path /_astro/*
	header @pages Cache-Control "public, max-age=0, must-revalidate"
}
