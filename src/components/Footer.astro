---
import Logo from './Logo.astro';
import { NAV, SITE } from '../site';
const year = new Date().getFullYear();
---
<footer class="footer dark">
  <div class="container cols">
    <div>
      <Logo />
      <p class="muted small">{SITE.tagline}.</p>
    </div>
    <nav aria-label="Lábléc">
      <ul>
        {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/kapcsolat">Kapcsolat</a></li>
      </ul>
    </nav>
    <div>
      <p class="small"><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      {SITE.phone && <p class="small"><a href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a></p>}
      {SITE.instagram && <p class="small"><a href={SITE.instagram} rel="noopener">Instagram</a></p>}
      <p class="small"><a href={SITE.app.url}>Alexercise app</a> · <a href="/rss.xml">RSS</a></p>
    </div>
  </div>
  <div class="container legal muted">© {year} {SITE.name}</div>
</footer>

<style>
  .footer { padding: 3.5rem 0 2rem; margin-top: 0; }
  .cols { display: grid; gap: 2rem; }
  @media (min-width: 720px) { .cols { grid-template-columns: 2fr 1fr 1.5fr; } }
  .small { font-size: 0.95rem; margin: 0.75rem 0 0; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.4rem; }
  .footer a:not(.logo) { color: var(--white); text-decoration: none; }
  .footer a:not(.logo):hover { color: var(--lime); }
  .legal { margin: 2.5rem auto 0; font-size: 0.9rem; padding-top: 1.5rem; border-top: 1px solid #2b282a; }
  .footer :global(.logo svg rect) { fill: #211f20; }
</style>
