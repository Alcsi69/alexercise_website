---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getPosts, formatDate, readingTime, type Post } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, tags } = post.data;
---
<Base title={title} description={description} type="article">
  <article class="section">
    <div class="container narrow">
      <p class="back"><a href="/blog">← Blog</a></p>
      <header class="post-head">
        <h1>{title}</h1>
        <p class="muted meta">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {updatedDate && <> · frissítve: <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></>}
          · {readingTime(post.body)} perc olvasás
        </p>
        {tags.length > 0 && <p class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</p>}
      </header>
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
  <CtaBand title="Tetszett az írás?" text="Ha szeretnéd, hogy ezt a gyakorlatban is együtt csináljuk, jelentkezz egy ingyenes konzultációra." />
</Base>

<style>
  .back { margin-bottom: 2rem; }
  .back a { text-decoration: none; font-weight: 600; }
  .post-head { margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 3px solid var(--lime); }
  .post-head h1 { font-size: clamp(2rem, 5vw, 3rem); }
  .meta { margin: 0; }
  .tags { display: flex; gap: 0.4rem; flex-wrap: wrap; margin: 0.75rem 0 0; }
</style>
