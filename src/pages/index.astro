---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../site';
import { getPosts } from '../utils';

const latest = (await getPosts()).slice(0, 3);
---
<Base>
  <section class="hero dark">
    <div class="container">
      <span class="eyebrow">Személyi edzés · Online coaching</span>
      <h1>Erősebb leszel.<br /><span class="hl">Okosabban.</span></h1>
      <p class="lead">
        Egyéni edzésterv, személyes visszajelzés és egy alkalmazás, amiben minden edzésed és fejlődésed nyomon követhető.
        Kezdőknek és haladóknak, edzőteremben vagy online.
      </p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/kapcsolat">Ingyenes konzultáció</a>
        <a class="btn btn-ghost" href="/szolgaltatasok">Szolgáltatások</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Hogyan dolgozunk</span>
      <h2>Három lépés a terved felé</h2>
      <ol class="grid grid-3 steps">
        <li class="card">
          <span class="num">1</span>
          <h3>Megismerlek</h3>
          <p class="muted">Ingyenes konzultáción átbeszéljük a céljaidat, az időbeosztásodat, az edzési múltadat és az esetleges ízületi panaszaidat.</p>
        </li>
        <li class="card">
          <span class="num">2</span>
          <h3>Elkészül a terved</h3>
          <p class="muted">Rád szabott edzéstervet kapsz, közvetlenül az Alexercise alkalmazásba. Nincs PDF, nincs papír.</p>
        </li>
        <li class="card">
          <span class="num">3</span>
          <h3>Edzel és fejlődsz</h3>
          <p class="muted">Rögzíted az edzéseidet, én látom a haladásodat, és hétről hétre finomítjuk a tervet.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section app-teaser">
    <div class="container split">
      <div>
        <span class="eyebrow">Az alkalmazás</span>
        <h2>Az edzésed a zsebedben</h2>
        <p class="lead">Minden ügyfelem hozzáfér az Alexercise apphoz. Telefonon, böngészőben, akár internet nélkül is működik.</p>
        <ul class="check-list">
          <li>Az edző által kijelölt tervek egy helyen</li>
          <li>Sorozatok, súlyok és pihenőidő rögzítése edzés közben</li>
          <li>Személyes csúcsok és fejlődési grafikonok</li>
          <li>Időpontfoglalás személyes vagy online alkalomra</li>
        </ul>
        <div class="btn-row">
          <a class="btn btn-secondary" href="/alkalmazas">Részletek</a>
          <a class="btn btn-ghost" href={SITE.app.url}>App megnyitása</a>
        </div>
      </div>
      <div class="phone" aria-hidden="true">
        <div class="screen">
          <p class="ps-title">Mai edzés</p>
          <p class="ps-sub">Felsőtest A · 6 gyakorlat</p>
          <div class="ps-row"><span>Fekvenyomás</span><b>4 × 8</b></div>
          <div class="ps-row"><span>Húzódzkodás</span><b>4 × 6</b></div>
          <div class="ps-row"><span>Vállból nyomás</span><b>3 × 10</b></div>
          <div class="ps-timer">Pihenő 01:30</div>
          <div class="ps-pr">Új csúcs! 85 kg</div>
        </div>
      </div>
    </div>
  </section>

  {latest.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="head">
          <div>
            <span class="eyebrow">Blog</span>
            <h2>Friss írások</h2>
          </div>
          <a href="/blog">Összes bejegyzés →</a>
        </div>
        <div class="grid grid-3">
          {latest.map((post) => <PostCard post={post} />)}
        </div>
      </div>
    </section>
  )}

  <CtaBand />
</Base>

<style>
  .hero { padding: 5rem 0 5.5rem; position: relative; overflow: hidden; }
  .hero::after {
    content: '';
    position: absolute;
    right: -6rem;
    bottom: -8rem;
    width: 22rem;
    height: 22rem;
    border: 3rem solid var(--lime);
    border-radius: 50%;
    opacity: 0.12;
    pointer-events: none;
  }
  .hero .container { position: relative; z-index: 1; }
  .hero h1 { max-width: 14ch; }
  .hl { color: var(--lime); }
  .hero .eyebrow { color: var(--lime); }

  .steps { list-style: none; padding: 0; margin: 2rem 0 0; }
  .num {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--black);
    color: var(--lime);
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .app-teaser { background: #ececf6; }
  .split { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 860px) { .split { grid-template-columns: 1.2fr 1fr; } }

  .phone {
    justify-self: center;
    width: 100%;
    max-width: 280px;
    aspect-ratio: 9 / 17;
    background: var(--black);
    border-radius: 2.25rem;
    padding: 0.75rem;
    box-shadow: 0 30px 60px -20px rgba(19, 17, 18, 0.45);
  }
  .screen {
    height: 100%;
    border-radius: 1.6rem;
    background: #1a1819;
    color: var(--white);
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.9rem;
  }
  .ps-title { font-size: 1.3rem; font-weight: 800; margin: 0; }
  .ps-sub { color: #8c8a93; margin: 0 0 0.5rem; }
  .ps-row { display: flex; justify-content: space-between; background: #211f20; border: 1px solid #2b282a; border-radius: 10px; padding: 0.65rem 0.8rem; }
  .ps-row b { color: var(--lime); }
  .ps-timer { margin-top: auto; text-align: center; background: var(--lime); color: var(--black); font-weight: 800; border-radius: 999px; padding: 0.6rem; }
  .ps-pr { text-align: center; color: #fff; background: var(--magenta); border-radius: 999px; padding: 0.4rem; font-weight: 700; font-size: 0.85rem; }

  .head { display: flex; justify-content: space-between; align-items: end; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .head h2 { margin: 0; }
</style>
